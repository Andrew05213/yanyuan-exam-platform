# Optional: original owner email for importing historical ownerless records.
# Set privately in the deployment environment; never commit a real value.
LEGACY_OWNER_EMAIL=

# Server-side administrator allowlists. Never use client-provided roles.
ADMIN_EMAILS=
ADMIN_USER_IDS=
# Stable 32-byte, base64-encoded encryption key, configured as a deployment secret.
# Keep it outside the database and source control; changing it requires key migration.
AI_CREDENTIALS_ENCRYPTION_KEY=
# Optional additional trusted HTTPS API hostnames for model discovery and subjective grading.
AI_MODEL_HOSTS=

# Legacy fallback until an administrator saves the independent audio configuration.
# Prefer the Provider and model controls in the admin dashboard.
ORAL_AUDIO_PROVIDER_ID=
